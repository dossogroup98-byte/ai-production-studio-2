import express, { Request, Response } from 'express';
import { createServer as createViteServer } from 'vite';
import path from 'path';
import cors from 'cors';
import dotenv from 'dotenv';
import fs from 'fs';

dotenv.config();

async function startServer() {
  const app = express();
  const PORT = parseInt(process.env.PORT || '3000', 10);

  app.use(cors());
  app.use(express.json({ limit: '50mb' }));
  app.use(express.urlencoded({ extended: true, limit: '50mb' }));

  // Health endpoint
  app.get(['/health', '/api/health'], (_req: Request, res: Response) => {
    res.json({
      status: 'healthy',
      service: 'AI Production Studio Full-Stack Server',
      timestamp: Date.now(),
      providers: {
        agnes_configured: !!process.env.AGNES_API_KEY,
        hedra_configured: !!process.env.HEDRA_API_KEY,
        cloudflare_configured: !!(process.env.CLOUDFLARE_ACCOUNT_ID && process.env.CLOUDFLARE_API_TOKEN),
      },
    });
  });

  // ---------------- AGNES Diagnostics & Probe Endpoint ----------------
  app.all('/api/studio/diagnostics/agnes', async (_req: Request, res: Response) => {
    const agnesKey = process.env.AGNES_API_KEY || '';
    const baseUrl = (process.env.AGNES_BASE_URL || 'https://apihub.agnes-ai.com/v1').replace(/\/$/, '');

    const agnesConfigured = !!agnesKey.trim();
    const hedraConfigured = !!(process.env.HEDRA_API_KEY || '').trim();
    const cfConfigured = !!((process.env.CLOUDFLARE_ACCOUNT_ID || '').trim() && (process.env.CLOUDFLARE_API_TOKEN || '').trim());

    let probeResult: any = {
      tested: false,
      status: 'NOT_TESTED',
      message: 'AGNES_API_KEY is not set in environment.',
      statusCode: null,
    };

    if (agnesConfigured) {
      try {
        const controller = new AbortController();
        const timeout = setTimeout(() => controller.abort(), 8000);
        const startTime = Date.now();
        // Safe, non-billing probe to /v1/models endpoint
        const probeResp = await fetch(`${baseUrl}/models`, {
          headers: {
            Authorization: `Bearer ${agnesKey.trim()}`,
            Accept: 'application/json',
          },
          signal: controller.signal,
        });
        clearTimeout(timeout);
        const latencyMs = Date.now() - startTime;
        const reqId = probeResp.headers.get('x-request-id') || probeResp.headers.get('cf-ray') || 'N/A';

        if (probeResp.status === 200) {
          probeResult = {
            tested: true,
            status: 'CONNECTED',
            statusCode: 200,
            latencyMs,
            requestId: reqId,
            message: 'Agnes AI API connected successfully (HTTP 200).',
          };
        } else if (probeResp.status === 401 || probeResp.status === 403) {
          probeResult = {
            tested: true,
            status: 'AUTH_FAILED',
            statusCode: probeResp.status,
            requestId: reqId,
            message: `Authentication failed (HTTP ${probeResp.status}). Please verify AGNES_API_KEY in backend/.env.`,
          };
        } else if (probeResp.status === 503) {
          probeResult = {
            tested: true,
            status: 'SERVICE_UNAVAILABLE',
            statusCode: 503,
            requestId: reqId,
            message: 'Agnes AI cluster returned HTTP 503 Service Unavailable (GPU queue overloaded or maintenance).',
          };
        } else {
          probeResult = {
            tested: true,
            status: 'HTTP_ERROR',
            statusCode: probeResp.status,
            requestId: reqId,
            message: `Agnes AI returned HTTP ${probeResp.status}: ${probeResp.statusText}`,
          };
        }
      } catch (err: any) {
        probeResult = {
          tested: true,
          status: 'NETWORK_ERROR',
          statusCode: 502,
          message: `Network probe failed: ${err.message || 'Connection timeout'}`,
        };
      }
    }

    res.json({
      timestamp: Date.now(),
      backend: {
        host: '127.0.0.1',
        port: PORT,
        status: 'RUNNING',
      },
      environment_variables: [
        { name: 'AGNES_API_KEY', configured: agnesConfigured },
        { name: 'AGNES_BASE_URL', configured: !!baseUrl },
        { name: 'HEDRA_API_KEY', configured: hedraConfigured },
        { name: 'CLOUDFLARE_ACCOUNT_ID', configured: !!process.env.CLOUDFLARE_ACCOUNT_ID },
        { name: 'CLOUDFLARE_API_TOKEN', configured: !!process.env.CLOUDFLARE_API_TOKEN },
      ],
      agnes_probe: probeResult,
      providers_status: {
        agnes: agnesConfigured ? 'Ayarlı & Hazır' : 'Eksik (backend/.env)',
        hedra: hedraConfigured ? 'Ayarlı & Hazır' : 'Eksik (backend/.env)',
        cloudflare: cfConfigured ? 'Ayarlı & Hazır' : 'Eksik (backend/.env)',
      },
    });
  });

  // ---------------- AGNES Text-to-Video (T2V ONLY) ----------------
  app.post('/api/studio/t2v', async (req: Request, res: Response) => {
    try {
      const { prompt, duration = 5, model = 'agnes-video-2.5', aspectRatio = '16:9' } = req.body;
      const agnesKey = (process.env.AGNES_API_KEY || '').trim();
      const baseUrl = (process.env.AGNES_BASE_URL || 'https://apihub.agnes-ai.com/v1').replace(/\/$/, '');

      if (!prompt || !prompt.trim()) {
        return res.status(400).json({ success: false, error: 'Prompt cannot be empty.' });
      }

      if (!agnesKey) {
        return res.status(401).json({
          success: false,
          status_code: 401,
          provider: 'agnes',
          error: 'AGNES_API_KEY is not configured in backend/.env. Please configure your key to generate real videos.',
        });
      }

      const seconds = Number(duration) >= 8 ? 10 : 5;
      const payload = {
        model,
        prompt: prompt.trim(),
        seconds,
        mode: 'text',
        aspect_ratio: aspectRatio,
      };

      const apiResp = await fetch(`${baseUrl}/videos`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${agnesKey}`,
          'User-Agent': 'AI-Production-Studio/2.0',
        },
        body: JSON.stringify(payload),
      });

      if (!apiResp.ok) {
        const status = apiResp.status;
        const errText = await apiResp.text();
        let errMsg = `AGNES API HTTP ${status}: ${errText.slice(0, 200)}`;
        if (status === 401) errMsg = 'AGNES 401: Invalid API key.';
        if (status === 403) errMsg = 'AGNES 403: Forbidden - Check account subscription or permissions.';
        if (status === 503) errMsg = 'AGNES 503: Service Unavailable. Upstream GPU queue is currently overloaded.';
        return res.status(status).json({ success: false, status_code: status, error: errMsg });
      }

      const data = (await apiResp.json()) as any;
      const jobId = data.id || data.video_id || data.task_id;
      if (!jobId) {
        return res.status(502).json({ success: false, error: 'No task ID returned from Agnes AI', raw: data });
      }

      return res.json({
        success: true,
        job_id: String(jobId),
        status: data.status || 'processing',
        video_url: data.video_url || data.output_url,
        provider: 'agnes',
      });
    } catch (err: any) {
      return res.status(500).json({ success: false, error: `AGNES dispatch error: ${err.message}` });
    }
  });

  // ---------------- Status Polling Endpoint (Real Status) ----------------
  app.get('/api/studio/status/:jobId', async (req: Request, res: Response) => {
    const { jobId } = req.params;

    // Route to Hedra if jobId indicates hedra
    if (jobId.toLowerCase().includes('hedra')) {
      const hedraKey = (process.env.HEDRA_API_KEY || '').trim();
      const baseUrl = (process.env.HEDRA_BASE_URL || 'https://api.hedra.com/v1').replace(/\/$/, '');
      if (!hedraKey) {
        return res.status(401).json({ status: 'failed', error: 'HEDRA_API_KEY is not configured in backend/.env' });
      }
      try {
        const resp = await fetch(`${baseUrl}/characters/${jobId}`, {
          headers: {
            'X-API-KEY': hedraKey,
            Authorization: `Bearer ${hedraKey}`,
          },
        });
        if (!resp.ok) {
          return res.status(resp.status).json({ status: 'failed', error: `Hedra check HTTP ${resp.status}` });
        }
        const data = (await resp.json()) as any;
        const st = String(data.status || '').toLowerCase();
        if (['completed', 'ready', 'done', 'succeeded'].includes(st)) {
          return res.json({ status: 'completed', video_url: data.videoUrl || data.url, raw: data });
        }
        if (['failed', 'error'].includes(st)) {
          return res.json({ status: 'failed', error: data.error || data.message || 'Avatar synthesis failed upstream' });
        }
        return res.json({ status: 'processing', progress: data.progress, raw: data });
      } catch (err: any) {
        return res.json({ status: 'processing', warning: err.message });
      }
    }

    // Default: Agnes status check
    const agnesKey = (process.env.AGNES_API_KEY || '').trim();
    const baseUrl = (process.env.AGNES_BASE_URL || 'https://apihub.agnes-ai.com/v1').replace(/\/$/, '');
    if (!agnesKey) {
      return res.status(401).json({ status: 'failed', error: 'AGNES_API_KEY is not configured in backend/.env' });
    }

    try {
      const resp = await fetch(`${baseUrl}/videos/${jobId}`, {
        headers: {
          Authorization: `Bearer ${agnesKey}`,
        },
      });

      if (!resp.ok) {
        if (resp.status === 404) {
          return res.status(404).json({ status: 'failed', error: `Video task ${jobId} not found on Agnes AI (HTTP 404)` });
        }
        if (resp.status === 503) {
          return res.json({ status: 'processing', warning: 'Upstream transient 503; retrying query...' });
        }
        return res.status(resp.status).json({ status: 'failed', error: `Status query HTTP ${resp.status}` });
      }

      const data = (await resp.json()) as any;
      const rawStatus = String(data.status || '').toLowerCase();

      if (['completed', 'succeeded', 'success', 'done'].includes(rawStatus)) {
        return res.json({
          status: 'completed',
          video_url: data.video_url || data.output_url || data.url,
          provider: 'agnes',
          raw: data,
        });
      }

      if (['failed', 'error'].includes(rawStatus)) {
        return res.json({
          status: 'failed',
          error: data.error || data.message || 'Agnes video generation failed upstream',
          raw: data,
        });
      }

      return res.json({
        status: 'processing',
        progress: data.progress,
        message: data.message || 'Rendering video frames on Agnes GPU cluster...',
        provider: 'agnes',
        raw: data,
      });
    } catch (err: any) {
      return res.json({ status: 'processing', warning: `Transient query error: ${err.message}` });
    }
  });

  // ---------------- Hedra Avatar Generation ----------------
  app.post('/api/studio/hedra', async (req: Request, res: Response) => {
    try {
      const { prompt, voiceText, imageData, aspectRatio = '1:1' } = req.body;
      const hedraKey = (process.env.HEDRA_API_KEY || '').trim();
      const baseUrl = (process.env.HEDRA_BASE_URL || 'https://api.hedra.com/v1').replace(/\/$/, '');

      if (!prompt && !voiceText) {
        return res.status(400).json({ success: false, error: 'Prompt or speech script is required.' });
      }

      if (!imageData) {
        return res.status(400).json({ success: false, error: 'Reference portrait image is required for Hedra avatar generation.' });
      }

      if (!hedraKey) {
        return res.status(401).json({
          success: false,
          status_code: 401,
          provider: 'hedra',
          error: 'HEDRA_API_KEY is not configured in backend/.env. Please configure your key to generate avatars.',
        });
      }

      const payload = {
        avatarImage: imageData,
        aspectRatio,
        text: voiceText || prompt,
        prompt: prompt || voiceText,
      };

      const resp = await fetch(`${baseUrl}/characters`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-API-KEY': hedraKey,
          Authorization: `Bearer ${hedraKey}`,
          'User-Agent': 'AI-Production-Studio/2.0',
        },
        body: JSON.stringify(payload),
      });

      if (!resp.ok) {
        const errText = await resp.text();
        return res.status(resp.status).json({ success: false, error: `Hedra API HTTP ${resp.status}: ${errText.slice(0, 200)}` });
      }

      const data = (await resp.json()) as any;
      const jobId = data.jobId || data.id || data.characterId;
      if (!jobId) {
        return res.status(502).json({ success: false, error: 'Hedra did not return a valid jobId', raw: data });
      }

      return res.json({
        success: true,
        job_id: String(jobId),
        status: 'processing',
        video_url: data.videoUrl || data.url,
        provider: 'hedra',
      });
    } catch (err: any) {
      return res.status(500).json({ success: false, error: `Hedra error: ${err.message}` });
    }
  });

  // ---------------- Cloudflare Workers AI (T2I & I2I) ----------------
  app.post('/api/studio/t2i', async (req: Request, res: Response) => {
    try {
      const { prompt, model = '@cf/black-forest-labs/flux-1-schnell', numSteps = 4, guidance = 7.5 } = req.body;
      const cfAccount = (process.env.CLOUDFLARE_ACCOUNT_ID || '').trim();
      const cfToken = (process.env.CLOUDFLARE_API_TOKEN || '').trim();

      if (!prompt || !prompt.trim()) {
        return res.status(400).json({ success: false, error: 'Prompt is required.' });
      }

      if (!cfAccount || !cfToken) {
        return res.status(401).json({
          success: false,
          status_code: 401,
          error: 'CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_API_TOKEN is not configured in backend/.env. Please configure your credentials.',
        });
      }

      const payload: any = { prompt: prompt.trim() };
      if (model.includes('flux')) {
        payload.num_steps = Math.min(Math.max(Number(numSteps) || 4, 1), 8);
      } else {
        payload.num_steps = Math.min(Math.max(Number(numSteps) || 20, 1), 20);
        if (guidance) payload.guidance = Number(guidance);
      }

      const cfResp = await fetch(`https://api.cloudflare.com/client/v4/accounts/${cfAccount}/ai/run/${model}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${cfToken}`,
          'User-Agent': 'AI-Production-Studio/2.0',
        },
        body: JSON.stringify(payload),
      });

      if (!cfResp.ok) {
        const errText = await cfResp.text();
        return res.status(cfResp.status).json({ success: false, error: `Cloudflare API HTTP ${cfResp.status}: ${errText.slice(0, 200)}` });
      }

      const ct = cfResp.headers.get('content-type') || '';
      if (ct.includes('image')) {
        const arrayBuf = await cfResp.arrayBuffer();
        const base64 = Buffer.from(arrayBuf).toString('base64');
        return res.json({
          success: true,
          image_url: `data:${ct};base64,${base64}`,
          provider: 'cloudflare',
          model,
          prompt,
        });
      } else {
        const json = (await cfResp.json()) as any;
        if (json?.result?.image) {
          return res.json({
            success: true,
            image_url: `data:image/png;base64,{json.result.image}`,
            provider: 'cloudflare',
            model,
            prompt,
          });
        }
        return res.status(502).json({ success: false, error: 'Unexpected JSON response from Cloudflare Workers AI', raw: json });
      }
    } catch (err: any) {
      return res.status(500).json({ success: false, error: err.message });
    }
  });

  app.post('/api/studio/i2i', async (req: Request, res: Response) => {
    try {
      const { prompt, imageData, model = '@cf/stabilityai/stable-diffusion-xl-base-1.0', strength = 0.75 } = req.body;
      const cfAccount = (process.env.CLOUDFLARE_ACCOUNT_ID || '').trim();
      const cfToken = (process.env.CLOUDFLARE_API_TOKEN || '').trim();

      if (!prompt || !prompt.trim()) {
        return res.status(400).json({ success: false, error: 'Prompt is required for Image-to-Image.' });
      }

      if (!imageData) {
        return res.status(400).json({ success: false, error: 'Input reference image is required for Image-to-Image.' });
      }

      // Check model support
      if (model.includes('flux')) {
        return res.status(400).json({
          success: false,
          error: "Model '@cf/black-forest-labs/flux-1-schnell' does not support Image-to-Image on Cloudflare Workers AI. Please select 'Stable Diffusion XL 1.0'.",
        });
      }

      if (!cfAccount || !cfToken) {
        return res.status(401).json({
          success: false,
          status_code: 401,
          error: 'CLOUDFLARE_ACCOUNT_ID or CLOUDFLARE_API_TOKEN is not configured in backend/.env.',
        });
      }

      let cleanB64 = imageData;
      if (cleanB64.includes('base64,')) {
        cleanB64 = cleanB64.split('base64,')[1];
      }
      const rawBytes = Buffer.from(cleanB64, 'base64');
      const imageArray = Array.from(rawBytes);

      const cfResp = await fetch(`https://api.cloudflare.com/client/v4/accounts/${cfAccount}/ai/run/${model}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${cfToken}`,
          'User-Agent': 'AI-Production-Studio/2.0',
        },
        body: JSON.stringify({
          prompt: prompt.trim(),
          image: imageArray,
          strength: Number(strength) || 0.75,
        }),
      });

      if (!cfResp.ok) {
        const errText = await cfResp.text();
        return res.status(cfResp.status).json({ success: false, error: `Cloudflare I2I HTTP ${cfResp.status}: ${errText.slice(0, 200)}` });
      }

      const ct = cfResp.headers.get('content-type') || '';
      if (ct.includes('image')) {
        const arrayBuf = await cfResp.arrayBuffer();
        const base64 = Buffer.from(arrayBuf).toString('base64');
        return res.json({
          success: true,
          image_url: `data:${ct};base64,${base64}`,
          provider: 'cloudflare',
          model,
        });
      } else {
        const json = (await cfResp.json()) as any;
        if (json?.result?.image) {
          return res.json({
            success: true,
            image_url: `data:image/png;base64,${json.result.image}`,
            provider: 'cloudflare',
            model,
          });
        }
        return res.status(502).json({ success: false, error: 'Unexpected format from Workers AI' });
      }
    } catch (err: any) {
      return res.status(500).json({ success: false, error: err.message });
    }
  });

  // ---------------- Backend Monorepo Files Viewer & Downloader ----------------
  app.get('/api/studio/files', (_req: Request, res: Response) => {
    try {
      const backendDir = path.resolve(process.cwd(), 'backend');
      const fileList = [
        'main.py',
        'routers/studio.py',
        'services/agnes_service.py',
        'services/hedra_service.py',
        'services/cloudflare_service.py',
        'requirements.txt',
        '.env.example',
        'start.bat',
        'start.sh',
        'test_studio.py',
      ];

      const files: Record<string, string> = {};
      for (const relPath of fileList) {
        const fullPath = path.join(backendDir, relPath);
        if (fs.existsSync(fullPath)) {
          files[relPath] = fs.readFileSync(fullPath, 'utf-8');
        }
      }

      res.json({ success: true, files });
    } catch (err: any) {
      res.status(500).json({ success: false, error: err.message });
    }
  });

  // ---------------- Vite / Frontend Middleware ----------------
  const isProd = process.env.NODE_ENV === 'production';
  if (!isProd) {
    const vite = await createViteServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  } else {
    app.use(express.static(path.resolve(process.cwd(), 'dist')));
    app.get('*', (_req: Request, res: Response) => {
      res.sendFile(path.resolve(process.cwd(), 'dist', 'index.html'));
    });
  }

  app.listen(PORT, '0.0.0.0', () => {
    console.log(`AI Production Studio server running on port ${PORT}`);
  });
}

startServer().catch((err) => {
  console.error('Failed to start server:', err);
  process.exit(1);
});
